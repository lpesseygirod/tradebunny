# Copy to .env and fill in. .env is gitignored — never commit real keys.

# NO AI KEY IS NEEDED. Grid Pilot has no model call at runtime — the approval
# note is a template over the measured statistics. ANTHROPIC_API_KEY used to
# live here and has been removed. The separate ledger/ package (the older
# news-prediction journal) still has a model call; set the key there if you
# run that side.
#
# Grid Pilot runs without any key at all. The OKX read-only key below is
# optional but strongly recommended: without it the fee tier is unknown and
# the system assumes the expensive one.

# OKX READ-ONLY api key, used ONLY to read your actual maker/taker fee tier
# (GET /api/v5/account/trade-fee). No trade permission is needed or wanted.
# Without these the system falls back to the PESSIMISTIC EEA rates
# (0.200% / 0.350%), which makes every gate stricter, never looser.
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
# OKX_SIMULATED=1   # set only to hit OKX's demo environment

# SEC EDGAR needs a contact email in the User-Agent or it returns 403. No key needed.
SEC_CONTACT_EMAIL=you@example.com

# Alpaca paper account — free, no KYC. https://alpaca.markets  (prices only)
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# Telegram: message @BotFather -> /newbot -> token. Then message your bot and read
# your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
